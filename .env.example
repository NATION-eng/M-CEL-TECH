# ─────────────────────────────────────────────────────────────────────────────
# M-CEL TECH — Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and configure these in Vercel / hosting settings.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mceltech.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2348116079309

# ─── Supabase PostgreSQL Database (from Supabase Dashboard -> Settings -> Database)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# ─── Paystack Payment Gateway (from Paystack Dashboard -> Settings -> API Keys)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=

# ─── Resend Automated Email Delivery (from Resend.com -> API Keys) ────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="M-CEL TECH <training@mceltech.com>"
ADMIN_EMAIL="training@mceltech.com"
