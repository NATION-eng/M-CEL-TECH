generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum TrainingMode {
  ONLINE
  PHYSICAL
  HYBRID
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CohortStatus {
  OPEN
  FULL
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  PAYMENT_PENDING
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

// ─────────────────────────────────────────────────────────────────────────
// training_programs — every programme M-CEL TECH offers, present or future
// ─────────────────────────────────────────────────────────────────────────

model TrainingProgram {
  id                   String        @id @default(uuid())
  title                String        @db.VarChar(200)
  slug                 String        @unique @db.VarChar(200)
  description          String
  shortDescription     String?       @map("short_description")
  price                Decimal       @db.Decimal(12, 2)
  currency             String        @default("NGN") @db.VarChar(10)
  trainingMode         TrainingMode  @default(HYBRID) @map("training_mode")
  duration             String?       @db.VarChar(100)
  registrationOpen     Boolean       @default(true) @map("registration_open")
  certificateAvailable Boolean       @default(true) @map("certificate_available")
  featured             Boolean       @default(false)
  status               ProgramStatus @default(ACTIVE)
  maxParticipants      Int?          @map("max_participants")
  bannerImage          String?       @map("banner_image")

  cohorts       Cohort[]
  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@map("training_programs")
}

// ─────────────────────────────────────────────────────────────────────────
// cohorts — scheduling slots within a programme
// ─────────────────────────────────────────────────────────────────────────

model Cohort {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  name            String       @db.VarChar(100)
  startDate       DateTime?    @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  /// Stored as free-form display text (e.g. "9:00 AM") rather than a DB
  /// TIME type — this is a display slot, not a scheduling engine.
  startTime       String?      @map("start_time") @db.VarChar(20)
  endTime         String?      @map("end_time") @db.VarChar(20)
  capacity        Int
  registeredCount Int          @default(0) @map("registered_count")
  status          CohortStatus @default(OPEN)
  location        String?

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId])
  @@index([status])
  @@map("cohorts")
}

// ─────────────────────────────────────────────────────────────────────────
// registrations — participant records
// ─────────────────────────────────────────────────────────────────────────

model Registration {
  id                 String @id @default(uuid())
  registrationNumber String @unique @map("registration_number") @db.VarChar(20)

  programId String          @map("program_id")
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohortId  String          @map("cohort_id")
  cohort    Cohort          @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  fullName        String  @map("full_name") @db.VarChar(120)
  certificateName String? @map("certificate_name") @db.VarChar(120)
  email           String  @db.VarChar(150)
  phone           String  @db.VarChar(30)
  gender          String? @db.VarChar(20)
  state           String? @db.VarChar(100)
  occupation      String? @db.VarChar(120)
  organization    String? @db.VarChar(150)

  registrationStatus    RegistrationStatus @default(PAYMENT_PENDING) @map("registration_status")
  receiptNumber         String?            @unique @map("receipt_number") @db.VarChar(50)
  paymentReference      String             @unique @map("payment_reference") @db.VarChar(100)
  confirmationEmailSent Boolean            @default(false) @map("confirmation_email_sent")
  referredBy            String?            @map("referred_by") @db.VarChar(100)
  referrerId            String?            @map("referrer_id")
  referrer              ReferralPartner?   @relation(fields: [referrerId], references: [id], onDelete: SetNull)

  payment   Payment?
  emailLogs EmailLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([programId])
  @@index([cohortId])
  @@index([paymentReference])
  @@index([receiptNumber])
  @@index([referredBy])
  @@index([referrerId])
  @@map("registrations")
}

// ─────────────────────────────────────────────────────────────────────────
// referral_partners — promoters / affiliates tracking table
// ─────────────────────────────────────────────────────────────────────────

model ReferralPartner {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(120)
  xHandle       String?  @map("x_handle") @db.VarChar(100)
  bankName      String?  @map("bank_name") @db.VarChar(100)
  accountNumber String?  @map("account_number") @db.VarChar(30)
  accountName   String?  @map("account_name") @db.VarChar(120)
  status        String   @default("ACTIVE") @db.VarChar(20)

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([status])
  @@map("referral_partners")
}

// ─────────────────────────────────────────────────────────────────────────
// promo_codes — secure, single-use vouchers & discount codes
// ─────────────────────────────────────────────────────────────────────────

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique @db.VarChar(50)
  tier          String    @db.VarChar(20)
  finalPrice    Decimal   @map("final_price") @db.Decimal(12, 2)
  label         String    @db.VarChar(120)
  maxUses       Int       @default(1) @map("max_uses")
  timesUsed     Int       @default(0) @map("times_used")
  isActive      Boolean   @default(true) @map("is_active")
  assignedEmail String?   @map("assigned_email") @db.VarChar(150)
  redeemedBy    String?   @map("redeemed_by") @db.VarChar(150)
  redeemedAt    DateTime? @map("redeemed_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

// ─────────────────────────────────────────────────────────────────────────
// payments — full payment history (financial record, never hard-deleted)
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id             String       @id @default(uuid())
  registrationId String       @unique @map("registration_id")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("NGN") @db.VarChar(10)
  gateway               String        @default("Paystack") @db.VarChar(50)
  paymentReference      String        @unique @map("payment_reference") @db.VarChar(100)
  transactionReference  String?       @map("transaction_reference") @db.VarChar(100)
  status                PaymentStatus @default(PENDING)
  gatewayResponse       Json?         @map("gateway_response")
  paidAt                DateTime?     @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([paymentReference])
  @@index([status])
  @@index([registrationId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
// email_logs — delivery tracking, provider-agnostic
// ─────────────────────────────────────────────────────────────────────────

model EmailLog {
  id             String        @id @default(uuid())
  registrationId String?       @map("registration_id")
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  email        String
  subject      String
  status       EmailStatus @default(PENDING)
  provider     String?
  messageId    String?     @map("message_id")
  errorMessage String?     @map("error_message")
  sentAt       DateTime?   @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([registrationId])
  @@index([status])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// system_settings — configurable values (avoid hardcoding business data)
// ─────────────────────────────────────────────────────────────────────────

model SystemSetting {
  id           String  @id @default(uuid())
  settingKey   String  @unique @map("setting_key")
  settingValue String  @map("setting_value")
  description  String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// audit_logs — system event trail
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String  @id @default(uuid())
  event       String
  description String?
  userType    String? @map("user_type")
  ipAddress   String? @map("ip_address")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@map("audit_logs")
}
